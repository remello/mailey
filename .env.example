# .env.example

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:your_db_port/your_db_name"

# RabbitMQ Configuration
RABBITMQ_URL="amqp://your_rabbitmq_user:your_rabbitmq_password@your_rabbitmq_host:your_rabbitmq_port/"
RABBITMQ_EMAIL_PROCESSING_QUEUE="email_processing_queue"

# Email Ingestor Service Configuration
CHECK_INTERVAL_MINUTES="5"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Fernet encryption key for IMAP passwords (generate a new one for production)
# To generate: from cryptography.fernet import Fernet; key = Fernet.generate_key(); print(key.decode())
ENCRYPTION_KEY="change_this_to_a_real_fernet_key"

# API Key (if API is implemented)
# API_KEY="your_secure_api_key"
